knitr::opts_chunk$set(
asp =  1.62,
fig.align = "center"
)
library(tidyverse)
temp <- c(80, 69, 66, 75, 77, 69, 68, 75, 91, 70, 80, 75, 69, 71, 50, 75, 64, 74, 52, 70, 66, 70, 53, 74, 61, 70, 73, 68, 61, 67, 57)
(x <- tibble(temp = rev(temp), year = 1995:2025))
x %>%
ggplot(aes(year, temp)) +
geom_line() +
scale_x_continuous(breaks = seq(1996, 2025, 4))
x %>%
ggplot(aes(year, temp)) +
geom_line() +
geom_smooth(method = "lm") +
scale_x_continuous(breaks = seq(1996, 2025, 4))
x %>%
mutate(
lag0 = temp,
lag1 = lag(temp),
lag2 = lag(temp, 2),
lead1 = lead(temp),
lead2 = lead(temp, 2)
) %>%
na.omit() %>%
gather(,,lag0:lead2) %>%
group_by(year) %>%
transmute(year, temp, ma_5 = mean(value)) %>%
gather("series", "value", -year) %>%
ggplot(aes(year, value, color = series)) +
geom_line() +
scale_x_continuous(breaks = seq(1996, 2025, 4))
set.seed(08182026)
innovations <- rnorm(
n = length(1995:2025),
mean = 0,
sd = sd(x$temp)
)
temp <- mean(x$temp) + cumsum(innovations)
(y <- tibble(year = 1995:2025, temp = temp))
y %>%
mutate(
lag0 = temp,
lag1 = lag(temp),
lag2 = lag(temp, 2),
lead1 = lead(temp),
lead2 = lead(temp, 2)
) %>%
na.omit() %>%
gather(,,lag0:lead2) %>%
group_by(year) %>%
transmute(year, temp, ma_5 = mean(value)) %>%
gather("series", "value", -year) %>%
ggplot(aes(year, value, color = series)) +
geom_line() +
scale_x_continuous(breaks = seq(1996, 2025, 4))
